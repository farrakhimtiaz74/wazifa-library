# Supabase credentials — get these from supabase.com > your project > Settings > API
# For GitHub Pages deployment, add these as GitHub repo Secrets:
# Settings > Secrets and variables > Actions > New repository secret
# (The anon key is public-safe because Row-Level Security protects all tables.)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
